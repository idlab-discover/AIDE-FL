{
  "name": "smoke-sklearn",
  "framework": "scikit_learn",
  "datasets": {
    "client1": "smoke_detection_iot_part1",
    "client2": "smoke_detection_iot_part2"
  },
  "hold_out_dataset": "smoke_detection_iot_part3",
  "centralised": false,
  "label_column": "Fire Alarm",
  "preprocessing": {
    "drop_columns": ["UTC"],
    "drop_rows": 0,
    "shuffle": false,
    "split": {
      "train": 0.75,
      "eval": 0.2,
      "test": 0.05
    }
  },
  "training": {
    "server_rounds": 10,
    "local_epochs": 5,
    "batch_size": 64
  },
  "aggregation": {
    "strategy": "fedavg",
    "fraction_fit": 1.0,
    "fraction_evaluate": 1.0,
    "min_available_clients": 2
  },
  "scikit_learn": {
    "model": {
      "kind": "logistic_regression",
      "n_features": 13,
      "classes": [0, 1],
      "penalty": "l2",
      "solver": "saga",
      "multi_class": "auto"
    }
  }
}
