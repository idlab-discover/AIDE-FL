{
  "name": "smoke-xgboost",
  "framework": "xgboost",
  "datasets": {
    "client1": "smoke_detection_iot_part1",
    "client2": "smoke_detection_iot_part2"
  },
  "hold_out_dataset": "smoke_detection_iot_part3",
  "centralised": false,
  "label_column": "Fire Alarm",
  "preprocessing": {
    "drop_columns": ["UTC"],
    "drop_rows": 0,
    "shuffle": false,
    "split": {
      "train": 0.75,
      "eval": 0.2,
      "test": 0.05
    }
  },
  "training": {
    "server_rounds": 10,
    "local_epochs": 1,
    "batch_size": 64
  },
  "aggregation": {
    "strategy": "fedxgbbagging",
    "fraction_fit": 1.0,
    "fraction_evaluate": 1.0,
    "min_available_clients": 2
  },
  "xgboost": {
    "model": {
      "kind": "booster",
      "n_features": 13
    },
    "params": {
      "objective": "binary:logistic",
      "eta": 0.1,
      "max_depth": 8,
      "eval_metric": "auc",
      "nthread": 16,
      "num_parallel_tree": 1,
      "subsample": 1,
      "tree_method": "hist"
    }
  }
}
