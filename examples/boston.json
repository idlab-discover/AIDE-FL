{
  "name": "boston",
  "datasets": {
    "client1": "boston_part1",
    "client2": "boston_part2"
  },
  "hold_out_dataset": "boston_part3",
  "centralised": false,
  "label_column": "label",
  "preprocessing": {
    "drop_columns": [],
    "drop_rows": 0,
    "shuffle": true,
    "split": {
      "train": 0.7,
      "eval": 0.25,
      "test": 0.05
    }
  },
  "hyper": {
    "server_rounds": 10,
    "local_epochs": 10,
    "batch_size": 16
  },
  "strategy": {
    "fraction_fit": 1,
    "fraction_evaluate": 1,
    "min_available_clients": 2
  },
  "model_file": "models/boston-model.json"
}
