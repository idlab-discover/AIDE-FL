{
  "name": "boston",
  "framework": "tensorflow",
  "datasets": {
    "client1": "boston_part1",
    "client2": "boston_part2"
  },
  "hold_out_dataset": "boston_part3",
  "centralised": false,
  "label_column": "label",
  "preprocessing": {
    "drop_columns": [],
    "drop_rows": 0,
    "shuffle": true,
    "split": {
      "train": 0.7,
      "eval": 0.25,
      "test": 0.05
    }
  },
  "training": {
    "server_rounds": 10,
    "local_epochs": 10,
    "batch_size": 16
  },
  "aggregation": {
    "strategy": "fedavg",
    "fraction_fit": 1,
    "fraction_evaluate": 1,
    "min_available_clients": 2
  },
  "tensorflow": {
    "model": {
      "config_file": "models/boston-model.json"
    }
  }
}
